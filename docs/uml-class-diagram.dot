digraph Strategy {
  rankdir=TB; nodesep=0.12; ranksep=1.25; fontname="Helvetica"; compound=true;
  node [shape=record, fontname="Helvetica", fontsize=10, style=filled, fillcolor="#FFFFFF"];
  edge [fontname="Helvetica", fontsize=9];

  subgraph cluster_p { label="Family 1 - Pricing"; style=filled; color="#BFE3C0"; fillcolor="#EAF7EA";
    PricingStrategy [label="{«interface»\nPricingStrategy||+ calculatePrice(request) : double\l+ name() : String\l}", fillcolor="#FFF8DC"];
    Std [label="{StandardPricingStrategy||rate x days\l}"];
    Wk  [label="{WeekendPremiumPricingStrategy||Sat/Sun x1.35, day by day\l}"];
    Lt  [label="{LongTermPackagePricingStrategy||7 full days + 60% extra days\l}"];
    Ly  [label="{LoyaltyTierPricingStrategy||discount table: type x category\l}"];
    PCtx [label="{PricingContext|- strategy|+ setStrategy(s)\l+ calculatePrice(request)\l}"];
    PSel [label="{PricingStrategySelector||+ select(request) : PricingStrategy\l}", fillcolor="#E8F0FE"];
    PMode [label="{«enum»\nPricingMode||+ createStrategy()\l}", fillcolor="#FFF8DC"];
    PCalc [label="{PricingCalculator||+ setMode(mode)\l+ calculate(request)\l}"];
  }

  subgraph cluster_d { label="Family 2 - Deposit"; style=filled; color="#F2C9A0"; fillcolor="#FDF0E2";
    DepositStrategy [label="{«interface»\nDepositStrategy||+ calculateDeposit(request, price) : double\l+ name() : String\l}", fillcolor="#FFF8DC"];
    Pct [label="{PercentageOfPriceDepositStrategy||25% of price\l}"];
    Flat [label="{CategoryFlatDepositStrategy||fixed amount by category\l}"];
    Risk [label="{RiskBasedDepositStrategy||credit score band x price, floor\l}"];
    DCtx [label="{DepositContext|- strategy|+ setStrategy(s)\l+ calculateDeposit(request, price)\l}"];
    DSel [label="{DepositStrategySelector||+ select(request) : DepositStrategy\l}", fillcolor="#E8F0FE"];
    CSP [label="{«interface»\nCreditScoreProvider||+ getScore(customerId) : int\l}", fillcolor="#FFF8DC"];
    Sim [label="{SimulatedCreditScoreProvider||stable pseudo scores\l}"];
  }

  subgraph cluster_c { label="Shared"; style=filled; color="#C9B8E8"; fillcolor="#F1ECFA";
    Req [label="{RentalRequest|car, days, customerType,\lstartDate, customerId\l}"];
    Car [label="{Car|id, model, category, dailyRate\l}"];
    Demo [label="{StrategyDemoApp||console menu\l}", fillcolor="#EEEEEE"];
  }

  Std -> PricingStrategy [arrowhead=empty, style=dashed]; Wk -> PricingStrategy [arrowhead=empty, style=dashed];
  Lt -> PricingStrategy [arrowhead=empty, style=dashed];  Ly -> PricingStrategy [arrowhead=empty, style=dashed];
  PCtx -> PricingStrategy [label="uses"]; PSel -> PricingStrategy [label="creates", style=dotted];
  PMode -> PricingStrategy [label="builds", style=dotted]; PCalc -> PCtx; PCalc -> PMode;

  Pct -> DepositStrategy [arrowhead=empty, style=dashed]; Flat -> DepositStrategy [arrowhead=empty, style=dashed];
  Risk -> DepositStrategy [arrowhead=empty, style=dashed];
  DCtx -> DepositStrategy [label="uses"]; DSel -> DepositStrategy [label="creates", style=dotted];
  Risk -> CSP [label="reads score"]; Sim -> CSP [arrowhead=empty, style=dashed]; DSel -> CSP;

  Req -> Car; Demo -> PCtx; Demo -> DCtx; Demo -> PSel; Demo -> DSel;

  // layout only: put the deposit family under the pricing family
  PricingStrategy -> Pct [style=invis]; PricingStrategy -> Flat [style=invis];
  PricingStrategy -> Risk [style=invis]; PricingStrategy -> DCtx [style=invis]; PricingStrategy -> DSel [style=invis];
  DepositStrategy -> Req [style=invis]; DepositStrategy -> Demo [style=invis];
}
